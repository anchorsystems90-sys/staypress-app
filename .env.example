# Server-only (Vercel → Project Settings → Environment Variables)
# Used by /api/feedback — never prefix with VITE_
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
# Optional. Default: Bento Tools <onboarding@resend.dev>
# FEEDBACK_FROM_EMAIL=Bento Tools <feedback@your-verified-domain.com>

# Required for production SEO builds: absolute canonical, og:image, sitemap.xml
# Set on Vercel → Production only (avoid preview domains in sitemap).
# VITE_SITE_URL=https://your-domain.com
