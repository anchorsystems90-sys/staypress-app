---
import BaseLayout from '../layouts/BaseLayout.astro'
import { CONTENT_PAGE_SEO, buildContentPageJsonLd, pathForMode } from '../seoData'
import { TOOLS } from '../toolCatalog'

const seo = CONTENT_PAGE_SEO.privacy
const origin = Astro.site?.origin ?? 'https://bentotools.app'
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  path={seo.path}
  jsonLd={buildContentPageJsonLd('privacy', origin)}
  variant="content"
  tagline={seo.tagline}
>
  <article class="content-page">
    <header class="content-page__header">
      <h1 class="content-page__title">Privacy &amp; about</h1>
      <p class="content-page__lede">
        Bento Tools is a free, open-source suite of small browser utilities.
        PDF and file tools are designed so your documents are not uploaded to
        process them. Word, text, and JSON tools run locally too — what you
        type stays in this tab.
      </p>
    </header>

    <section class="content-page__section" aria-labelledby="what-stays">
      <h2 id="what-stays" class="content-page__h2">What stays on your device</h2>
      <p>
        When you add images or PDFs, they are read and processed with
        in-browser libraries (including pdf-lib and pdf.js). Previews and
        downloads are generated locally. Bento Tools does not send your
        documents to a server for conversion, merge, extract, or compress.
      </p>
      <p>
        Word Unscrambler matches letters against a word list in the same
        browser tab. Text Cleaner, Case Converter, and JSON Formatter
        transform whatever you paste here the same way. You only share a
        result when <em>you</em> copy or download it and choose where it goes
        next.
      </p>
    </section>

    <section class="content-page__section" aria-labelledby="what-network">
      <h2 id="what-network" class="content-page__h2">What may use the network</h2>
      <p>
        A few things still talk to the internet, on purpose and separately from
        your files:
      </p>
      <ul class="content-page__list">
        <li>
          <strong>Loading the app</strong> — HTML, JavaScript, CSS, fonts, and
          library workers so Bento Tools can run.
        </li>
        <li>
          <strong>Optional analytics</strong> — page-level usage metrics (via
          Vercel Analytics) to understand which tools people open. That does
          not include your PDF, image, or letter contents.
        </li>
        <li>
          <strong>Feedback form</strong> — only if you send a message. The
          text of bug reports, feature requests, or a hello is emailed to the
          team. Your working files are not attached.
        </li>
      </ul>
    </section>

    <section class="content-page__section" aria-labelledby="accounts">
      <h2 id="accounts" class="content-page__h2">No accounts</h2>
      <p>
        Bento Tools does not require sign-in. There is no Bento Tools cloud
        document storage and no server-side conversion queue for your uploads.
      </p>
    </section>

    <section class="content-page__section" aria-labelledby="tools">
      <h2 id="tools" class="content-page__h2">The tools</h2>
      <p>Jump back into a job. Every tool below runs in your browser:</p>
      <ul class="content-page__tools">
        {
          TOOLS.map(({ id, label }) => (
            <li>
              <a class="content-page__tool-link" href={pathForMode(id)}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="content-page__section" aria-labelledby="guide">
      <h2 id="guide" class="content-page__h2">Guide</h2>
      <p>
        Need iPhone photos as a PDF? Read{' '}
        <a href="/guides/heic-to-pdf">Convert HEIC to PDF privately</a>.
      </p>
    </section>

    <section class="content-page__section" aria-labelledby="who">
      <h2 id="who" class="content-page__h2">Who builds Bento Tools</h2>
      <p>
        Bento Tools is an open-source product from{' '}
        <a
          href="https://anchorsystems.dev/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Anchor Systems
        </a>
        . Source is on GitHub so you can audit how conversion works and what
        the app sends over the network.
      </p>
    </section>

    <p class="content-page__note">
      This page describes the current product. If something in the app ever
      changes how files are handled, we will update this page to match.
    </p>
  </article>
</BaseLayout>
