---
import type { AppMode } from '../types'
import { MODE_META } from '../types'
import { pathForMode } from '../seoData'
import { PDF_TOOL_IDS } from '../toolCatalog'

type Props = {
  mode: AppMode
}

const { mode } = Astro.props
---

<div class="mode-switch" role="tablist" aria-label="PDF tools">
  {
    PDF_TOOL_IDS.map((id) => {
      const active = id === mode
      return (
        <a
          href={pathForMode(id)}
          role="tab"
          aria-selected={active}
          class:list={['mode-switch__btn', active && 'mode-switch__btn--active']}
        >
          {MODE_META[id].label}
        </a>
      )
    })
  }
</div>
