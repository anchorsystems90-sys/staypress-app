---
import FeedbackTrigger from './FeedbackTrigger'
import {
  CONTENT_PAGE_SEO,
  DEFAULT_FOOTER_PRIVACY,
  GITHUB_REPO,
} from '../seoData'
---

<footer class="footer">
  <a
    class="footer__ph"
    href="https://www.producthunt.com/products/staypress-pdf?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-staypress-pdf"
    target="_blank"
    rel="noopener noreferrer"
  >
    <img
      alt="Staypress PDF - Merge, convert & slim PDFs — all on your device | Product Hunt"
      width="250"
      height="54"
      src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1271913&theme=light&t=1791321295030"
    />
  </a>
  <p class="footer__privacy">{DEFAULT_FOOTER_PRIVACY}</p>
  <p class="footer__maker">
    Bento Tools by{' '}
    <a
      class="footer__maker-link"
      href="https://anchorsystems.dev/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Anchor Systems
    </a>
  </p>
  <nav class="footer__links" aria-label="Project">
    <a class="footer__link" href={CONTENT_PAGE_SEO.privacy.path}>
      {CONTENT_PAGE_SEO.privacy.footerLabel}
    </a>
    <span class="footer__maker-sep" aria-hidden="true">·</span>
    <a class="footer__link" href={CONTENT_PAGE_SEO['heic-to-pdf'].path}>
      {CONTENT_PAGE_SEO['heic-to-pdf'].footerLabel}
    </a>
    <span class="footer__maker-sep" aria-hidden="true">·</span>
    <a
      class="footer__link"
      href={GITHUB_REPO}
      target="_blank"
      rel="noopener noreferrer"
    >
      Source
    </a>
    <span class="footer__maker-sep" aria-hidden="true">·</span>
    <FeedbackTrigger client:idle />
  </nav>
</footer>
