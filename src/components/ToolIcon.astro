---
import type { ToolId } from '../toolCatalog'
import {
  IconToolBase64,
  IconToolCaseConverter,
  IconToolCsvColumnExtractor,
  IconToolCsvToJson,
  IconToolImagesToPdf,
  IconToolJsonFormatter,
  IconToolJsonToCsv,
  IconToolMergePdf,
  IconToolPdfToImages,
  IconToolSlimPdf,
  IconToolTextCleaner,
  IconToolWordUnscrambler,
} from './Icons'

type Props = {
  id: ToolId
}

const { id } = Astro.props
---

{
  id === 'images' ? (
    <IconToolImagesToPdf />
  ) : id === 'merge' ? (
    <IconToolMergePdf />
  ) : id === 'extract' ? (
    <IconToolPdfToImages />
  ) : id === 'slim' ? (
    <IconToolSlimPdf />
  ) : id === 'word-unscrambler' ? (
    <IconToolWordUnscrambler />
  ) : id === 'text-cleaner' ? (
    <IconToolTextCleaner />
  ) : id === 'case-converter' ? (
    <IconToolCaseConverter />
  ) : id === 'json-formatter' ? (
    <IconToolJsonFormatter />
  ) : id === 'base64' ? (
    <IconToolBase64 />
  ) : id === 'csv-column-extractor' ? (
    <IconToolCsvColumnExtractor />
  ) : id === 'csv-to-json' ? (
    <IconToolCsvToJson />
  ) : (
    <IconToolJsonToCsv />
  )
}
