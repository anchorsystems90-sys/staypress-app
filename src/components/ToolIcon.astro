---
import type { ToolId } from '../toolCatalog'
import {
  IconToolCaseConverter,
  IconToolCsvColumnExtractor,
  IconToolImagesToPdf,
  IconToolJsonFormatter,
  IconToolMergePdf,
  IconToolPdfToImages,
  IconToolSlimPdf,
  IconToolTextCleaner,
  IconToolWordUnscrambler,
} from './Icons'

type Props = {
  id: ToolId
}

const { id } = Astro.props
---

{
  id === 'images' ? (
    <IconToolImagesToPdf />
  ) : id === 'merge' ? (
    <IconToolMergePdf />
  ) : id === 'extract' ? (
    <IconToolPdfToImages />
  ) : id === 'slim' ? (
    <IconToolSlimPdf />
  ) : id === 'word-unscrambler' ? (
    <IconToolWordUnscrambler />
  ) : id === 'text-cleaner' ? (
    <IconToolTextCleaner />
  ) : id === 'case-converter' ? (
    <IconToolCaseConverter />
  ) : id === 'json-formatter' ? (
    <IconToolJsonFormatter />
  ) : (
    <IconToolCsvColumnExtractor />
  )
}
