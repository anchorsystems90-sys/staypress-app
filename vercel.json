{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/merge", "destination": "/merge/index.html" },
    { "source": "/extract", "destination": "/extract/index.html" },
    { "source": "/slim", "destination": "/slim/index.html" },
    { "source": "/compress", "destination": "/slim/index.html" },
    { "source": "/images", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" }
  ]
}
