{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "images" }],
      "destination": "/images-to-pdf",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "merge" }],
      "destination": "/merge",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "extract" }],
      "destination": "/extract",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "slim" }],
      "destination": "/slim",
      "permanent": true
    },
    {
      "source": "/images",
      "destination": "/images-to-pdf",
      "permanent": true
    },
    {
      "source": "/compress",
      "destination": "/slim",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
