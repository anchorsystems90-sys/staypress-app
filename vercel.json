{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/images",
      "destination": "/images-to-pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/images-to-pdf", "destination": "/images-to-pdf/index.html" },
    { "source": "/merge", "destination": "/merge/index.html" },
    { "source": "/extract", "destination": "/extract/index.html" },
    { "source": "/slim", "destination": "/slim/index.html" },
    { "source": "/compress", "destination": "/slim/index.html" },
    { "source": "/word-unscrambler", "destination": "/word-unscrambler/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    {
      "source": "/guides/heic-to-pdf",
      "destination": "/guides/heic-to-pdf/index.html"
    }
  ]
}
